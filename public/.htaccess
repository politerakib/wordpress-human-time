Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pretty URLs for core endpoints
    RewriteRule ^download/?$ download.php [L,QSA]
    RewriteRule ^download/([A-Za-z0-9_-]+)/?$ download.php?token=$1 [L,QSA]
    RewriteRule ^download/([A-Za-z0-9_-]+)/file/?$ download.php?token=$1&download=1 [L,QSA]
    RewriteRule ^upload/?$ upload.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
